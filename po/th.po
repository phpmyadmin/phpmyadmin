msgstr ""
"หากใช้การยืนยันตัวตนแบบ [kbd]cookie[/kbd] และ %sการจัดเก็บคุกกี้เข้าสู่ระบบ%s ไม่ใช่ 0 จะต้อ"
"งกำหนด %sอายุการใช้งานของคุกกี้เข้าสู่ระบบ%s ให้มีค่าน้อยกว่าหรือเท่ากับค่านั้น"

#: libraries/classes/Config/ServerConfigChecks.php:472
#, php-format
msgid ""
"%1$sBzip2 compression and decompression%2$s requires functions (%3$s) which "
