msgstr "เส้นโค้งที่มีการประมาณค่าในช่วงเชิงเส้นระหว่างจุด"

#: libraries/classes/Types.php:423
msgid "A polygon"
msgstr "รูปหลายเหลี่ยม"

#: libraries/classes/Types.php:426
